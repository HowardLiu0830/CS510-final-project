# Copy to .env and fill in your keys.

# Required for any real LLM call. Without it the agent runs in offline stub mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Optional: Semantic Scholar API key (higher rate limits)
S2_API_KEY=

# OpenAlex polite pool — set to a contact email
OPENALEX_EMAIL=

# Cache dir override (default: data/cache)
RESEARCH_TRAIL_CACHE_DIR=
